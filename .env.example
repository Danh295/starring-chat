# Copy to .env and fill in. Never commit .env.
PORT=3000
# Twitch app (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Bot account that reads chat, and the channels it joins (comma separated)
BOT_USERNAME=
CHANNELS=
# eventsub (default) or irc (anonymous read-only fallback)
CHAT_SOURCE=eventsub
# OpenAI (optional: without a key, roles come from data/fallback-roles.json)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional: minimal / low / medium / high (only for reasoning models; lower is faster)
OPENAI_REASONING_EFFORT=
# Password for /control.html actions
CONTROL_PASSWORD=
# Post "Now starring @user as The Role" in chat
ANNOUNCE_IN_CHAT=false
# Most people cast per episode
MAX_CAST=40
# Simulated chat for rehearsing without Twitch
DEMO_CHAT=false
DEMO_SPEED=1
# Channel name the demo overlay/control page use
DEMO_CHANNEL=demo
